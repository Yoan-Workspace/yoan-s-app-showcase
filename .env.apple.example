# Copier vers .env.apple (ne pas committer .env.apple ni le .p8)
# App Store Connect → Utilisateurs et accès → Intégrations → In-App Purchase

APPLE_IAP_KEY_ID=XXXXXXXXXX
APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Chemin relatif au repo, ou absolu
APPLE_IAP_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8

# Optionnel : force un bundle (sinon --app allfaves|rappel|phototopdf)
# APPLE_BUNDLE_ID=com.yoansoussand.AllFaves
